
\begin{thenomenclature} 
\nomgroup{A}
  \item [{$\cands$}]\begingroup The sample space of $\rvcand$, the set of all candidate sets.\nomeqref {0.0}\nompageref{1}
  \item [{$\candsw{w}$}]\begingroup The sample space of $\rvcand$ given $\rv{W} = w$, the set of all candidate sets of cardinality $w$.\nomeqref {0.0}\nompageref{1}
  \item [{$\cov(\tparam\sysparamvec \given w)$}]\begingroup The \emph{expected} variance-covariance of the asymptotic sampling distribution of $\mle$.\nomeqref {0.0}\nompageref{1}
  \item [{$\cov(\tparam\sysparamvec)$}]\begingroup The \emph{expected} variance-covariance of the asymptotic sampling distribution of $\mleu$.\nomeqref {0.0}\nompageref{1}
  \item [{$\cv_j$}]\begingroup The continuous random lifetime of the \jth component.\nomeqref {0.0}\nompageref{1}
  \item [{$\ell(\sysparamvec \given w\,,\,\cdot\;)$}]\begingroup The log-likelihood function conditioned on $\rv{W} = w$.\nomeqref {0.0}\nompageref{1}
  \item [{$\indicator{\mathcal{X}}$}]\begingroup The indicator function $\indicator{\mathcal{X}} \colon \mathcal{X} \mapsto \{0,1\}$ outputs $1$ if the input is a member of $\mathcal{X}$ and otherwise outputs $0$.\nomeqref {0.0}\nompageref{1}
  \item [{$\infomatrx(\tparam\sysparamvec \given w)$}]\begingroup The \emph{expected} information matrix for a random masked system failure times conditioned on $w$ candidates.\nomeqref {0.0}\nompageref{1}
  \item [{$\infomatrx(\tparam\sysparamvec)$}]\begingroup The \emph{expected} information matrix for a random masked system failure times.\nomeqref {0.0}\nompageref{1}
  \item [{$\infomatrxn(\tparam\sysparamvec \given w)$}]\begingroup The \emph{expected} information matrix for a random sample of $n$ masked system failure times conditioned on $w$ candidates.\nomeqref {0.0}\nompageref{1}
  \item [{$\infomatrxn(\tparam\sysparamvec)$}]\begingroup The \emph{expected} information matrix for a random sample of $n$ masked system failure times.\nomeqref {0.0}\nompageref{1}
  \item [{$\jointpdf$}]\begingroup The joint conditioned probability density function of $\rvcand$, $\sv$ given some realization of $\rv{W}$.\nomeqref {0.0}\nompageref{1}
  \item [{$\likelihood(\sysparamvec \given w\,,\,\cdot\;)$}]\begingroup The likelihood function.\nomeqref {0.0}\nompageref{1}
  \item [{$\mfs$}]\begingroup A random sample of $n$ masked system failure times.\nomeqref {0.0}\nompageref{1}
  \item [{$\mfso$}]\begingroup A realization of a sample of $n$ masked system failure times.\nomeqref {0.0}\nompageref{1}
  \item [{$\mfsw$}]\begingroup A random sample of $n$ masked system failure times conditioned on $w$ candidates.\nomeqref {0.0}\nompageref{1}
  \item [{$\mle$}]\begingroup The maximum likelihood estimator conditioned on a sample of $n$ masked system failure times in which only candidate sets of cardinality $w$ are observed .\nomeqref {0.0}\nompageref{1}
  \item [{$\mleu$}]\begingroup The maximum likelihood estimator conditioned on a sample of $n$ masked system failure times.\nomeqref {0.0}\nompageref{1}
  \item [{$\pdf_j$}]\begingroup The probability density function of $\cv_j$.\nomeqref {0.0}\nompageref{1}
  \item [{$\pfam$}]\begingroup The parametric family of the system.\nomeqref {0.0}\nompageref{1}
  \item [{$\pfami$}]\begingroup The parametric family of the component lifetimes.\nomeqref {0.0}\nompageref{1}
  \item [{$\pmf_{\rv{K} \given \sv, \rv{W}}$}]\begingroup The conditional probability mass function of $\rv{W}$ given some realization of $\sv$ and $\rv{W}$.\nomeqref {0.0}\nompageref{1}
  \item [{$\pmf_{\rv{W}}$}]\begingroup The marginal probability mass function of $\rv{W}$.\nomeqref {0.0}\nompageref{1}
  \item [{$\rvcand$}]\begingroup The discrete random variable (set) denoting the components of a candidate set.\nomeqref {0.0}\nompageref{1}
  \item [{$\rv{K}$}]\begingroup The discrete random variable denoting the cause of system failure.\nomeqref {0.0}\nompageref{1}
  \item [{$\rv{W}$}]\begingroup The discrete random variable denoting the cardinality of the candidate set.\nomeqref {0.0}\nompageref{1}
  \item [{$\sampd$}]\begingroup The sampling distribution of $\mle$.\nomeqref {0.0}\nompageref{1}
  \item [{$\sampdu$}]\begingroup The sampling distribution of $\mleu$.\nomeqref {0.0}\nompageref{1}
  \item [{$\score(\sysparamvec \given w\,,\,\cdot\;)$}]\begingroup The score function, the gradient of the log-likelihood.\nomeqref {0.0}\nompageref{1}
  \item [{$\spdf$}]\begingroup The probability density function of $\sv$.\nomeqref {0.0}\nompageref{1}
  \item [{$\sv$}]\begingroup The continuous random lifetime of the series system.\nomeqref {0.0}\nompageref{1}
  \item [{$\sysparam$}]\begingroup A parameter index (matrix) of the parametric family of the system.\nomeqref {0.0}\nompageref{1}
  \item [{$\sysparam_j$}]\begingroup A parameter index (vector) of the parametric family of the \jth component.\nomeqref {0.0}\nompageref{1}
  \item [{$\sysparamvec$}]\begingroup A parameter index (vector) of the parametric family of the system.\nomeqref {0.0}\nompageref{1}
  \item [{$\tparam\sysparam$}]\begingroup The true parameter index (matrix) of the parametric family of the system.\nomeqref {0.0}\nompageref{1}
  \item [{$\tparam\sysparamvec$}]\begingroup The true parameter index (vector) of the parametric family of the system.\nomeqref {0.0}\nompageref{1}

\end{thenomenclature}
